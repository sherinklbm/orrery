# Copy to deploy/.env and fill in (install.sh writes it for you). Never commit the real .env (it is git-ignored).
DOMAIN=example.com
N8N_DOMAIN=n8n.example.com
ACME_EMAIL=you@example.com
TZ=UTC

# Control panel login. Create the hash with:  docker compose run --rm console python server.py hash-password
CONSOLE_USER=admin
CONSOLE_PASSWORD_HASH='paste-the-scrypt-hash-here'
# 32+ random characters:  openssl rand -hex 32
CONSOLE_SECRET=

# Encrypts credentials stored in n8n. Generate once, back it up, never change it:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Pin a tested n8n version (check the n8n releases page) instead of "latest".
N8N_VERSION=latest

# The AI gateway for n8n and Hermes. The AI provider, model and API key are NOT here: pick them in the panel (AI providers tab).
# These tokens only let n8n and Hermes talk to the gateway, and let the gateway read the panel's choice (24+ characters each:  openssl rand -hex 24).
AI_RUNTIME_TOKEN=
LLM_GATE_TOKEN_N8N=
LLM_GATE_TOKEN_HERMES=
